# ==============================================================================
# STRICT .GITIGNORE: Smart Surveillance System
# ==============================================================================

# 1. Environment files & secrets (Allow ONLY .env.example)
.env
.env.*
.env*.local
*.env
!.env.example
*.local
backend/.env
frontend/.env
**/.*.env
**/.env*
!**/.env.example

# 2. Database files & dumps
*.db
*.sqlite
*.sqlite3
*.sql
*.sql.gz
*.dump
*.dump.gz
*.tar
*.bak
backup_*.sql
*.backup
pgdata/
postgres_data/
**/pgdata/
**/postgres_data/

# 3. Database-related pictures, snapshots, face crops, captures & media
data/
**/data/
snapshots/
**/snapshots/
faces/
**/faces/
uploads/
**/uploads/
captures/
**/captures/
recordings/
**/recordings/
media/
**/media/
dataset/
**/dataset/
datasets/
**/datasets/
backend/data/
backend/backend/data/
*.jpg
*.jpeg
*.png
*.bmp
*.webp
*.mp4
*.avi
*.mkv
*.mov
# Exceptions for frontend UI icons if needed:
!frontend/public/*.svg
!frontend/src/assets/*.svg

# 4. Secrets, keys & credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*credentials*.json
*client_secret*.json
id_rsa*
id_ecdsa*
id_ed25519*

# 5. Heavy / Generated files & dependencies
node_modules/
**/node_modules/
venv/
.venv/
**/venv/
**/.venv/
env/
.env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
**/dist/
build/
**/build/
.next/
**/.next/
.vite/
**/.vite/
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Large model weights & checkpoints
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.weights
*.bin
*.engine
*.safetensors
models/*.pt
models/*.onnx
models/**/*.pt
models/**/*.onnx
backend/models/*.pt
backend/models/*.onnx
yolov8*.pt

# Allow weapon threat detection model
!models/weapon/threat-yolov8n.pt

# 7. IDE, OS & Temporary files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
*.tmp
